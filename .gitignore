# ── Secrets – NEVER commit ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*_secret*
*_password*

# ── Data & SQLite ─────────────────────────────────────────────────────────────
data/
*.db
*.db-wal
*.db-shm

# ── Output (digests, .ics files) ──────────────────────────────────────────────
outbox/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
pip-wheel-metadata/

# ── Testing / tooling ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# ── Traces (LLM call logs) ────────────────────────────────────────────────────
# Ignore runtime trace files but keep sample traces for judges / reviewers.
traces/
!docs/sample_traces/

# Keep trap-pack results so they can be reviewed
!tests/trap_pack_results.json

# ── Frontend ──────────────────────────────────────────────────────────────────
node_modules/
.DS_Store
Thumbs.db

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
