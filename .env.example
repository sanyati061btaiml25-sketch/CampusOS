# ── Core (required) ───────────────────────────────────────────────────────────

# Path to the SQLite database file (data/ is git-ignored).
# Note: relative paths are automatically resolved relative to the repository root.
CAMPUSOS_DB=data/campusos.db

# Run mode: live | mock | replay
#   live    – real network calls (default)
#   mock    – offline deterministic payloads, no keys needed
#   replay  – replay saved raw payloads from data/raw/
CAMPUSOS_MODE=live

# ── Stop controls ─────────────────────────────────────────────────────────────

# Create this file on disk to stop the daemon cleanly after the current run.
# (kill_switch in the settings table is the other mechanism.)
# Note: relative paths are automatically resolved relative to the repository root.
KILL_FILE=data/KILL

# ── Output ────────────────────────────────────────────────────────────────────

# Directory where the daemon will write digest files and .ics calendar invites.
# Note: relative paths are automatically resolved relative to the repository root.
# [planned – not yet written by the current code]
SANDBOX_INBOX=outbox/

# ── Optional: LLM extraction (leave blank to skip; mock mode needs none) ──────

# Google Gemini (used for LLM-assisted field extraction when implemented)
# GOOGLE_API_KEY=AIza...

# ── Optional: additional job sources (disabled by default in schema) ──────────

# Adzuna – set both keys to enable the adzuna source
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# ── Note ──────────────────────────────────────────────────────────────────────
# mock mode (CAMPUSOS_MODE=mock or --mock flag) needs NONE of the keys above.
# Run `campusos-daemon --mock --once` to test the full pipeline offline.
# The daemon loads this file automatically at startup; shell exports take priority.
