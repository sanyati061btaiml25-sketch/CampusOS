# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite database file.
# Default: data/campusos.db  (the data/ directory is git-ignored)
CAMPUSOS_DB=data/campusos.db

# ── Application ───────────────────────────────────────────────────────────────
# A long random string used to sign sessions / tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=

# Runtime environment: development | staging | production
APP_ENV=
